# Sunshine Infra Production Configuration
# Copy this file to .env.local or .env.production to configure production webhooks.

# Google Sheets Lead Submission Webhook
# Deploy a Google Apps Script Web App attached to your leads Google Sheet.
# Set the access permissions to "Anyone" and paste the Web App URL here:
VITE_LEAD_SUBMISSION_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec
